doctype html
html(lang="hr")
  head
    meta(charset="UTF-8")
    title Sustav za propusnice
  body
    h1 Sustav za propusnice

    p Ukupno propusnica: #{totalPasses}
    p Aktivne propusnice: #{activePasses}

    hr

    if isAuthenticated
      p Prijavljeni ste kao: #{user.name || user.sub}
      p 
        a(href="/admin/passes") Upravljanje propusnicama
      p 
        a(href="/logout") Odjava
    else
      p 
        a(href="/login") Prijava